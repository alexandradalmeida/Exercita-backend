DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_SETTINGS_MODULE=config.settings.dev
POSTGRES_DB=exercita
POSTGRES_USER=exercita_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
# URL publico do backend (usado nos links de email)
BACKEND_URL=http://localhost:8000

# Porta do Postgres exposta no host (muda se a 5432 estiver ocupada)
DB_HOST_PORT=5432

# Encriptacao do telefone (AES-256-GCM): 32 bytes em base64
FIELD_ENCRYPTION_KEY=troque-por-chave-base64-de-32-bytes

# Google OAuth
GOOGLE_CLIENT_ID=google-client-id-ficticio
GOOGLE_CLIENT_SECRET=google-client-secret-ficticio
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# Apple Sign In
APPLE_CLIENT_ID=com.exemplo.exercita
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=ABCDE12345
APPLE_PRIVATE_KEY_PATH=./AuthKey_ficticia.p8
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback/

# Embeddings (matching de PTs)
OPENAI_API_KEY=sk-ficticia

# Comissao da plataforma sobre cada pagamento (BR-06), em percentagem
PLATFORM_COMMISSION_PERCENT=15

# Multicaixa Express (mock por omissao ate haver credenciais/documentacao oficial)
MULTICAIXA_BACKEND=mock
MULTICAIXA_WEBHOOK_SECRET=segredo-ficticio-do-webhook
